#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Kaptain contributors (Fred Cooke)
#
# Main deploy entry point. Prepares and deploys manifests to a
# Kubernetes namespace via the namespace-locked k wrapper.
set -euo pipefail

# Phase tracking and signal handling
UNINTERRUPTIBLE=false
SHUTDOWN_REQUESTED=false
ERROR_EXIT_CODE=0
PHASE="Pre Validation"
CHILD_PID=""
RUN_COMMAND=""

# Job mode sleep durations (seconds) - configurable via environment
POST_DEPLOY_SLEEP_SUCCESS="${POST_DEPLOY_SLEEP_SUCCESS:-600}"    # 10 minutes
POST_DEPLOY_SLEEP_FAILURE="${POST_DEPLOY_SLEEP_FAILURE:-86400}"  # 24 hours

# How long a run-platform that has just reapplied its own manifests waits for
# Kubernetes to replace it before reporting that the replacement never came
SELF_REPLACEMENT_WAIT="${SELF_REPLACEMENT_WAIT:-600}"            # 10 minutes

# Interruptible sleep using read builtin - signals interrupt immediately
# unlike external sleep which blocks trap handlers until it completes.
# fd 9 holds a self-referencing FIFO (writer never closes) so read -t blocks
# for the full timeout; without it stdin is /dev/null in a no-TTY pod and
# read returns instantly on EOF, spinning any surrounding while-loop at 100% CPU.
# Defined conditionally so tests can override via export -f.
if ! declare -f interruptible_sleep > /dev/null 2>&1; then
  # Reserve an unused path for the FIFO without creating anything yet.
  sleep_fifo="$(mktemp -u)"
  # Create the FIFO at that path.
  mkfifo "${sleep_fifo}"
  # Open fd 9 for both read AND write on the FIFO; the write side keeps the
  # FIFO from ever signalling EOF to the read side, so read -t can block.
  exec 9<>"${sleep_fifo}"
  # Unlink the path now - fd 9 keeps the FIFO alive in the kernel after removal
  rm -f "${sleep_fifo}"
  # Drop the variable since fd 9 is the only handle we need from here on.
  unset sleep_fifo

  interruptible_sleep() {
    read -t "$1" -r -u 9 || true
  }
fi

# Run a command in the background and wait, allowing trap handlers to
# fire immediately. The trap handler can then kill the child process.
run() {
  RUN_COMMAND="$*"
  "$@" &
  CHILD_PID=$!
  local rc=0
  while true; do
    wait "${CHILD_PID}" && rc=0 || rc=$?
    # kill -0 sends no signal - it just checks if the process is alive.
    # If a trap handler returned without exiting, wait exits early but
    # the child is still running, so we loop back and wait again.
    kill -0 "${CHILD_PID}" 2>/dev/null || break
  done
  CHILD_PID=""
  RUN_COMMAND=""
  return ${rc}
}

change_phase() {
  if [[ "${SHUTDOWN_REQUESTED}" == "true" ]]; then
    notify-info "Shutdown requested during ${PHASE} - respecting SIGTERM"
    notify-info "Expect a new environment version to complete deployment"
    exit 0
  fi
  UNINTERRUPTIBLE="$1"
  PHASE="$2"
}

handle_term() {
  if [[ "${UNINTERRUPTIBLE}" == "true" ]]; then
    notify-info "SIGTERM received during ${PHASE} - deferring until complete"
    SHUTDOWN_REQUESTED=true
  else
    notify-info "SIGTERM received during ${PHASE} - shutting down"
    if [[ -n "${CHILD_PID}" ]]; then
      kill -9 "${CHILD_PID}" 2>/dev/null || true
    fi
    exit "${ERROR_EXIT_CODE}"
  fi
}
trap 'handle_term' TERM

# SIGINT for manual exec-in reruns, not needed for Kube, but should respect Ctrl+C, too
handle_int() {
  notify-warning "SIGINT received - operator interference during ${PHASE}"
  if [[ -n "${CHILD_PID}" ]]; then
    kill -9 "${CHILD_PID}" 2>/dev/null || true
  fi
  exit 130
}
trap 'handle_int' INT

handle_err() {
  ERROR_EXIT_CODE=$?
  UNINTERRUPTIBLE=false
  local line_no="${BASH_LINENO[0]}"
  local command="${RUN_COMMAND:-${BASH_COMMAND}}"

  local error_type
  if [[ ${ERROR_EXIT_CODE} -ge 3 && ${ERROR_EXIT_CODE} -le 125 ]]; then
    error_type="Deployment"
  else
    error_type="Unexpected"
  fi

  local message="${error_type} error during ${PHASE}
  Exit code: ${ERROR_EXIT_CODE}
  Line: ${line_no}
  Command: ${command}
  Call stack:"
  for i in "${!FUNCNAME[@]}"; do
    message+="
    ${i}: ${FUNCNAME[${i}]}() at ${BASH_SOURCE[${i}]}:${BASH_LINENO[${i}]}"
  done
  message+="
Check pod logs for more detail or exec in and inspect the audit directory."

  notify-failure "${message}"

  if [[ "${SHUTDOWN_REQUESTED}" == "true" ]]; then
    notify-info "Shutdown already requested - exiting"
    exit ${ERROR_EXIT_CODE}
  fi

  # Sleep behavior depends on DEPLOY_MODE
  # shellcheck disable=SC2154 # DEPLOY_MODE set by environment, validated by validate-environment
  if [[ "${DEPLOY_MODE}" == "deployment" ]]; then
    notify-info "Sleeping forever for inspection..."
    while true; do interruptible_sleep 3600; done
  else
    notify-info "Sleeping ${POST_DEPLOY_SLEEP_FAILURE}s before exit, to allow for inspection..."
    interruptible_sleep "${POST_DEPLOY_SLEEP_FAILURE}"
    exit ${ERROR_EXIT_CODE}
  fi
}
trap 'handle_err' ERR

# Fails the deploy through handle_err, so the failure is reported and the pod
# kept for inspection like any other
replacement_never_came() {
  return 60
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/lib"

# shellcheck source=src/scripts/lib/timestamp.bash
source "${LIB_DIR}/timestamp.bash"
# shellcheck source=src/scripts/lib/token-format.bash
source "${LIB_DIR}/token-format.bash"

# Defaults for thread-opening message - validation will catch if actually missing
ENVIRONMENT="${ENVIRONMENT:-UNKNOWN_ENVIRONMENT}"
VERSION="${VERSION:-UNKNOWN_VERSION}"
# Restarted deploys of the same version rejoin their chat thread
export NOTIFY_THREAD_KEY="${NOTIFY_THREAD_KEY:-${ENVIRONMENT}-${VERSION}}"
start_timestamp=$(human_timestamp)
start_seconds=$(date -u '+%s')

# Before the first message, which opens the chat thread
validate-notify

notify-info "*Starting ${ENVIRONMENT} version ${VERSION} deployment process* at ${start_timestamp}"

if ! validate-tooling; then
  notify-failure "Tooling validation failed, this message may not send.

Use an appropriate base image and build process!"
  exit 43
fi
validate-environment
validate-container

# Token name and delimiter styles must be set in the image by the build
if ! validate_token_styles; then
  notify-failure "Token style validation failed - check TOKEN_NAME_STYLE and TOKEN_DELIMITER_STYLE"
  exit 45
fi

# Path setup - RUN_BASE_PATH allows tests to override
base="${RUN_BASE_PATH:-/kd}"
work="${base}/work"
decrypted="${work}/decrypted"
audit="${work}/audit"

log "Initialising structure..."
mkdir -p "${work}/manifests"
mkdir -p "${decrypted}"
mkdir -p "${audit}"
mkdir -p "${audit}/kubectl"  # Optimise 'k' process
find "${work}"

change_phase false "Preparing manifests"
run prepare-manifests

change_phase false "Processing secrets"
run decrypt-secrets
# shellcheck disable=SC2154 # TOKEN_NAME_STYLE set by environment build process
run "${SCRIPT_DIR}/plugins/token-name-validators/${TOKEN_NAME_STYLE}" "${decrypted}"
run assemble-secrets
# After the secret work so work/manifests is complete when it is copied out to
# the dirs each step applies from (stages/deploy, and on a run-platform self
# and seed/*); before validation because it deletes the seed-and-compare
# markers, which are not real manifests and would fail it.
run split-manifests

# TODO also record resource types so we can show what changes somehowe
run scan-images "before"

# TODO verify that the env is in a decent shape and note down details of bad stuff so we can ensre it hasn't gotten worse

# CRDs and Namespaces go in before anything else is even validated. A resource
# of a custom kind cannot be dry-run until its CRD is in the cluster, and
# nothing can be dry-run into a namespace that is not there. Each is dry-run
# and applied as one step, CRDs first, and each is its own uninterruptible
# phase: a SIGTERM during the CRDs is honoured before the Namespaces start.
# Only a run-platform brings either.
# shellcheck disable=SC2154 # ENVIRONMENT_TYPE set by final environment image build, validated by validate-environment
if [[ "${ENVIRONMENT_TYPE}" == "meta-env" ]]; then
  change_phase true "Applying CRDs"
  run apply-crds
  change_phase true "Applying Namespaces"
  run apply-namespaces
fi

change_phase false "Validating manifests"
run validate-manifests
# Two things a run-platform applies that are not in the tree, each validated
# its own way. A child's role binding in the child's own namespace, which k
# cannot dry-run and split-manifests took out. And the cluster-scoped resources
# children have delegated, which go in under each child's field manager.
if [[ "${ENVIRONMENT_TYPE}" == "meta-env" ]]; then
  run validate-child-role-bindings
  run validate-on-behalf
fi

# A run-platform looks at itself before it deploys anything, so that it never
# does so on stale config or secrets. Only CRDs and Namespaces are in by now,
# and they use none of it.
if [[ "${ENVIRONMENT_TYPE}" == "meta-env" ]]; then
  change_phase true "Reapplying own manifests if changed"
  run reapply-self-if-changed

  case "$(<"${work}/self-outcome")" in
    continue)
      ;;
    stand-down)
      # Deployment mode: the apply changed our own pod template, so Kubernetes
      # is replacing this pod with one that mounts the new config. That pod
      # does the deploy. This one must not, and it must not exit either: the
      # container would restart in the same pod, still on the old config.
      change_phase false "Waiting to be replaced"
      notify-info "Waiting up to ${SELF_REPLACEMENT_WAIT}s to be replaced by a pod running the reapplied manifests"
      interruptible_sleep "${SELF_REPLACEMENT_WAIT}"
      notify-error "Reapplied our own manifests ${SELF_REPLACEMENT_WAIT}s ago and this pod has not been replaced - the new pod is probably failing to start"
      replacement_never_came
      ;;
    handed-over)
      # Job mode: a new Job, started from the reapplied CronJob, does the deploy
      change_phase false "Handed over"
      exit 0
      ;;
    *)
      notify-error "reapply-self-if-changed left no outcome deploy understands in ${work}/self-outcome"
      exit 42
      ;;
  esac
fi

change_phase true "Applying manifests"
# On a run-platform, what its children need of it goes in first, before any
# child's deployer: each child's role binding in its own namespace, then the
# cluster-scoped resources each child has delegated
if [[ "${ENVIRONMENT_TYPE}" == "meta-env" ]]; then
  run apply-child-role-bindings
  run apply-on-behalf
fi
run apply-manifests
# After the rest of the run-platform is applied: child environments marked
# seed-and-compare are seeded, or reapplied only if something real changed
if [[ "${ENVIRONMENT_TYPE}" == "meta-env" ]]; then
  run reapply-seeds-if-changed
fi
# TODO apply in a more sophisticated way
# TODO verify things are happy after this action - await happiness - but don't accept increasing restarts on anything declared
# TODO clean up stuff we don't have declared - leave the environment exactly as declared

run scan-images "after"

run notify-images-changed

elapsed=$(( $(date -u '+%s') - start_seconds ))
notify-success "Deployment complete for ${ENVIRONMENT} version ${VERSION} in ${elapsed} seconds"

change_phase false "Complete"

# Sleep behavior depends on DEPLOY_MODE
# shellcheck disable=SC2154 # DEPLOY_MODE set by environment, validated by validate-environment
if [[ "${DEPLOY_MODE}" == "deployment" ]]; then
  notify-info "Deployment complete - sleeping forever..."
  while true; do interruptible_sleep 3600; done
else
  notify-info "Deployment complete - sleeping ${POST_DEPLOY_SLEEP_SUCCESS}s before exit..."
  interruptible_sleep "${POST_DEPLOY_SLEEP_SUCCESS}"
fi
