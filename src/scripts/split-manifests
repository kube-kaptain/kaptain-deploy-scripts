#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Kaptain contributors (Fred Cooke)
#
# Split phase: set aside the run-platform's own set and every child set marked
# for seed-and-compare.
#
# Run-platform deploys only (ENVIRONMENT_TYPE=meta-env). An environment never
# holds a marked set, so on an environment deploy any marker fails the deploy.
#
# A run-platform's manifests hold one directory per child. Its own set, always
# named for ENVIRONMENT, moves first to work/self whether marked or not, since
# it is treated very differently from the rest. Each remaining child whose set
# carries the seed-and-compare marker (an environment's deployer) then moves to
# work/seed/<child>. This runs after the secret work, so a set-aside set is
# complete, and before validation and apply, so those phases only see what is
# applied now.
#
# The marker is a ConfigMap in a namespace that never exists, so a stray one
# fails the apply rather than landing anywhere. A set-aside set has been held
# back deliberately, so its marker has done its job and is removed.
set -euo pipefail

base="${RUN_BASE_PATH:-/kd}"
work_dir="${base}/work/manifests"
self_dir="${base}/work/self"
seed_dir="${base}/work/seed"
marker_name="run-environment-seed-and-compare-marker.yaml"

environment_type="${ENVIRONMENT_TYPE:?ENVIRONMENT_TYPE is required (env or meta-env)}"

if [[ ! -d "${work_dir}" ]]; then
  notify-error "Manifests work directory does not exist: ${work_dir}"
  exit 1
fi

# Collected first: the moves below would disturb a find still walking the tree.
markers=()
while IFS= read -r -d '' marker; do
  markers+=("${marker}")
done < <(find "${work_dir}" -type f -name "${marker_name}" -print0 | sort -z)

if [[ "${environment_type}" != "meta-env" ]]; then
  if [[ ${#markers[@]} -eq 0 ]]; then
    log "No seed-and-compare sets to set aside"
    exit 0
  fi
  for marker in "${markers[@]}"; do
    notify-error "Seed-and-compare marker in a ${environment_type} deploy: ${marker#"${work_dir}"/}"
  done
  notify-error "Only a run-platform (meta-env) deploy sets aside seed-and-compare sets"
  exit 1
fi

# Every marker is checked before anything moves, self's included: once self is
# out of the tree a marker misplaced inside it would go unseen.
for marker in "${markers[@]}"; do
  # The marker must sit at the top of a child set; anywhere else it cannot say
  # which set to hold back.
  if [[ "$(dirname "$(dirname "${marker}")")" != "${work_dir}" ]]; then
    notify-error "Seed-and-compare marker is not at the top of a child set: ${marker#"${work_dir}"/}"
    exit 1
  fi
done

# shellcheck disable=SC2154 # ENVIRONMENT set by final environment image build, validated by validate-environment
if [[ ! -d "${work_dir}/${ENVIRONMENT}" ]]; then
  notify-error "Run-platform's own set does not exist: ${ENVIRONMENT}"
  exit 1
fi

mv "${work_dir}/${ENVIRONMENT}" "${self_dir}"
log "Set aside run-platform's own set: ${ENVIRONMENT} -> self"
if [[ -f "${self_dir}/${marker_name}" ]]; then
  rm "${self_dir}/${marker_name}"
  log "Removed seed-and-compare marker from ${ENVIRONMENT}"
fi

seeded=0
for marker in "${markers[@]}"; do
  child_dir=$(dirname "${marker}")
  child=$(basename "${child_dir}")
  if [[ "${child}" == "${ENVIRONMENT}" ]]; then
    continue
  fi
  mkdir -p "${seed_dir}"
  mv "${child_dir}" "${seed_dir}/${child}"
  log "Set aside for seeding: ${child}"
  rm "${seed_dir}/${child}/${marker_name}"
  log "Removed seed-and-compare marker from ${child}"
  seeded=$((seeded + 1))
done

if [[ ${seeded} -eq 0 ]]; then
  log "No seed-and-compare sets to set aside besides the run-platform's own"
else
  log "Set aside ${seeded} seed-and-compare set(s) in ${seed_dir}"
fi
