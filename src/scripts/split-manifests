#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Kaptain contributors (Fred Cooke)
#
# Split phase: copy every manifest out of the complete tree into the dir of the
# step that applies it.
#
# work/manifests is the complete set once the secret work is done, and it stays
# complete: validation reads it as one tree and nothing is moved out of it.
# Each top-level entry is copied whole to exactly one of:
#
#   work/self            the run-platform's own set, always named for ENVIRONMENT
#   work/seed/<child>    each child set marked for seed-and-compare
#   work/stages/deploy   everything else, which is what the deploy applies
#
# The first two exist on run-platform deploys only (ENVIRONMENT_TYPE=meta-env).
# An environment never holds a marked set, so on an environment deploy any
# marker fails the deploy.
#
# The marker is a ConfigMap in a namespace that never exists, so a stray one
# fails the apply rather than landing anywhere. It is deleted as its set is
# reached, just before that set is copied, so nothing after this meets one.
#
# Runs once per container. If any dir it writes is already there it refuses,
# rather than copy over what an earlier run left and apply a mixture.
set -euo pipefail

base="${RUN_BASE_PATH:-/kd}"
work_dir="${base}/work/manifests"
self_dir="${base}/work/self"
seed_dir="${base}/work/seed"
stages_dir="${base}/work/stages"
deploy_dir="${stages_dir}/deploy"
marker_name="run-environment-seed-and-compare-marker.yaml"

environment_type="${ENVIRONMENT_TYPE:?ENVIRONMENT_TYPE is required (env or meta-env)}"

# Checks first. None of them changes anything, so a deploy that fails here
# leaves the work dir exactly as it was.

if [[ ! -d "${work_dir}" ]]; then
  notify-error "Manifests work directory does not exist: ${work_dir}"
  exit 1
fi

for written_dir in "${self_dir}" "${seed_dir}" "${stages_dir}"; do
  if [[ -e "${written_dir}" ]]; then
    notify-error "Split has already run in this container, refusing to run it again: ${written_dir} exists"
    exit 1
  fi
done

if [[ "${environment_type}" != "meta-env" ]]; then
  stray_marker=false
  while IFS= read -r -d '' marker; do
    notify-error "Seed-and-compare marker in a ${environment_type} deploy: ${marker#"${work_dir}"/}"
    stray_marker=true
  done < <(find "${work_dir}" -type f -name "${marker_name}" -print0 | sort -z)

  if [[ "${stray_marker}" == "true" ]]; then
    notify-error "Only a run-platform (meta-env) deploy holds seed-and-compare sets"
    exit 1
  fi
else
  while IFS= read -r -d '' marker; do
    # The marker must sit at the top of a child set; anywhere else it cannot say
    # which set it marks.
    if [[ "$(dirname "$(dirname "${marker}")")" != "${work_dir}" ]]; then
      notify-error "Seed-and-compare marker is not at the top of a child set: ${marker#"${work_dir}"/}"
      exit 1
    fi
  done < <(find "${work_dir}" -type f -name "${marker_name}" -print0 | sort -z)

  # shellcheck disable=SC2154 # ENVIRONMENT set by final environment image build, validated by validate-environment
  if [[ ! -d "${work_dir}/${ENVIRONMENT}" ]]; then
    notify-error "Run-platform's own set does not exist: ${ENVIRONMENT}"
    exit 1
  fi
fi

# One pass over the top of the tree. For each entry: delete its marker if it
# has one, then copy it whole to where it belongs. Whether a set is marked is
# read off the set as it is reached, so nothing is carried between entries.
#
# Top-level dot files and dot dirs are not matched by the glob and are not
# copied. Validation ignores them too, so nothing unvalidated is applied.
mkdir -p "${deploy_dir}"

shopt -s nullglob
seeded=0
for entry in "${work_dir}"/*; do
  name=$(basename "${entry}")

  marked=false
  if [[ -f "${entry}/${marker_name}" ]]; then
    rm "${entry}/${marker_name}"
    log "Removed seed-and-compare marker from ${name}"
    marked=true
  fi

  if [[ "${environment_type}" == "meta-env" && "${name}" == "${ENVIRONMENT}" ]]; then
    cp -a "${entry}" "${self_dir}"
    log "Run-platform's own set: ${name} -> self"
  elif [[ "${marked}" == "true" ]]; then
    mkdir -p "${seed_dir}"
    cp -a "${entry}" "${seed_dir}/${name}"
    log "Seed-and-compare set: ${name} -> seed/${name}"
    seeded=$((seeded + 1))
  else
    cp -a "${entry}" "${deploy_dir}/${name}"
  fi
done
shopt -u nullglob

if [[ "${environment_type}" == "meta-env" ]]; then
  log "Split complete: the run-platform's own set to self, ${seeded} seed-and-compare set(s) to seed, the rest to stages/deploy"
else
  log "Split complete, all to stages/deploy"
fi
