#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Kaptain contributors (Fred Cooke)
#
# Validate environment variables before deploy and after final build.
# Checks required env vars and runs plugin validators.
set -euo pipefail

log "Validating environment variables up front..."

failures=0

# Required environment variables
if [[ -z "${DEPLOY_MODE:-}" ]]; then
  notify-error "DEPLOY_MODE must be set"
  failures=$((failures + 1))
elif [[ "${DEPLOY_MODE}" != "deployment" && "${DEPLOY_MODE}" != "job" ]]; then
  notify-error "DEPLOY_MODE must be 'deployment' or 'job', got '${DEPLOY_MODE}'"
  failures=$((failures + 1))
fi

if [[ -z "${ENVIRONMENT:-}" ]]; then
  notify-error "ENVIRONMENT must be set"
  failures=$((failures + 1))
fi

if [[ -z "${ENVIRONMENT_TYPE:-}" ]]; then
  notify-error "ENVIRONMENT_TYPE must be set"
  failures=$((failures + 1))
elif [[ "${ENVIRONMENT_TYPE}" != "env" && "${ENVIRONMENT_TYPE}" != "meta-env" ]]; then
  notify-error "ENVIRONMENT_TYPE must be 'env' or 'meta-env', got '${ENVIRONMENT_TYPE}'"
  failures=$((failures + 1))
else
  case "${ENVIRONMENT_TYPE}" in
    env)
      if [[ "${ENVIRONMENT:-}" =~ ^run-platform(-|$) ]]; then
        notify-error "ENVIRONMENT '${ENVIRONMENT}' for ENVIRONMENT_TYPE=env must not start with 'run-platform-' (that is reserved for meta-env)"
        failures=$((failures + 1))
      elif ! [[ "${ENVIRONMENT:-}" =~ ^run-[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
        notify-error "ENVIRONMENT '${ENVIRONMENT:-}' for ENVIRONMENT_TYPE=env must match 'run-<name>[-<more>...]' with lowercase alphanumeric kebab segments"
        failures=$((failures + 1))
      fi
      ;;
    meta-env)
      if ! [[ "${ENVIRONMENT:-}" =~ ^run-platform-[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
        notify-error "ENVIRONMENT '${ENVIRONMENT:-}' for ENVIRONMENT_TYPE=meta-env must match 'run-platform-<name>[-<more>...]' with lowercase alphanumeric kebab segments"
        failures=$((failures + 1))
      fi
      ;;
  esac
fi

if [[ -z "${VERSION:-}" ]]; then
  notify-error "VERSION must be set"
  failures=$((failures + 1))
fi

if [[ -z "${TOKEN_DELIMITER_STYLE:-}" ]]; then
  notify-error "TOKEN_DELIMITER_STYLE must be set"
  failures=$((failures + 1))
fi

if [[ -z "${TOKEN_NAME_STYLE:-}" ]]; then
  notify-error "TOKEN_NAME_STYLE must be set"
  failures=$((failures + 1))
fi

# Cannot deploy anything if there are no manifests
manifests_dir="${RUN_BASE_PATH:-/kd}/manifests"
if [[ ! -d "${manifests_dir}" ]]; then
  notify-error "Manifests directory not found at ${manifests_dir}"
  failures=$((failures + 1))
fi

# Cleanup configuration isn't supplied via env var since it's structured data.
# It is written into the image by the env or RP build and must be present. The
# ConfigMap has two keys, the configuration as lifted from the env's KaptainPM
# YAML file and the matching schema used to validate it during the build. Only
# presence is verified here since already validated before inclusion. A recheck
# is done at runtime using a light weight go schema validator called jv.
cleanup_policy_manifest="${manifests_dir}/kaptain-environment-cleanup-policy.yaml"

if [[ ! -f "${cleanup_policy_manifest}" ]]; then
  notify-error "Cleanup policy ConfigMap not found at ${cleanup_policy_manifest}"
  failures=$((failures + 1))
else
  # Both keys must exist and be non-empty. The cleanup-policy document always
  # carries at least apiVersion, kind and its one spec section.
  for cleanup_key in cleanup-policy.yaml kaptainpm-schema.json; do
    if ! yq -e ".data | has(\"${cleanup_key}\")" "${cleanup_policy_manifest}" > /dev/null 2>&1; then
      notify-error "Cleanup policy ConfigMap at ${cleanup_policy_manifest} has no '${cleanup_key}' data key"
      failures=$((failures + 1))
    elif [[ -z "$(yq -r ".data[\"${cleanup_key}\"] // \"\"" "${cleanup_policy_manifest}" 2>/dev/null || true)" ]]; then
      notify-error "Cleanup policy ConfigMap key '${cleanup_key}' is empty"
      failures=$((failures + 1))
    fi
  done
fi

# Run plugin validators
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
shopt -s nullglob
for validator in "${script_dir}"/validate-environment-*; do
  if [[ ! -f "${validator}" ]]; then
    notify-error "Environment validation script '${validator}' is not a file!"
    failures=$((failures + 1))
  elif [[ ! -x "${validator}" ]]; then
    notify-error "Environment validation script '${validator}' is not executable!"
    failures=$((failures + 1))
  elif ! "${validator}"; then
    failures=$((failures + 1))
  fi
done
shopt -u nullglob

# Report result
if [[ ${failures} -eq 0 ]]; then
  notify-info "Environment validation passed - continuing"
elif [[ ${failures} -eq 1 ]]; then
  notify-error "Environment validation failed with 1 error"
  exit 44
else
  notify-error "Environment validation failed with ${failures} errors"
  exit 44
fi
