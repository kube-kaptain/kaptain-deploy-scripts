#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Kaptain contributors (Fred Cooke)
#
# Validate manifests against Kubernetes API via dry-run.
# Validates each file individually, capturing output to audit directory.
set -euo pipefail

base="${RUN_BASE_PATH:-/kd}"
work_dir="${base}/work"
manifests_dir="${work_dir}/manifests"
audit_dir="${work_dir}/audit/validation"

mkdir -p "${audit_dir}"

log "Validating manifests against API server (dry-run)"

scanned=0
passed=0
failed=0
failed_files=()

shopt -s globstar nullglob

# The set applied now, plus on a run-platform the sets split-manifests held
# back: its own and every child marked for seeding. Those are applied by hand
# later, so they get validated here while there is a cluster to validate them
# against.
sets=("${manifests_dir}")
if [[ "${ENVIRONMENT_TYPE:-}" == "meta-env" ]]; then
  sets+=("${work_dir}/self" "${work_dir}/seed"/*)
fi

for set_dir in "${sets[@]}"; do
  [[ -d "${set_dir}" ]] || continue

  for manifest in "${set_dir}"/**/*.yaml; do
    [[ -f "${manifest}" ]] || continue

    # Audit filename is flattened from the path within the work dir, so the
    # sets cannot collide: seed/run-a/app.yaml → seed_run-a_app.txt
    relative="${manifest#"${work_dir}/"}"
    audit_file="${audit_dir}/${relative//\//_}"
    audit_file="${audit_file%.yaml}.txt"

    scanned=$((scanned + 1))

    if k apply --dry-run=server --server-side --field-manager="kaptain/${ENVIRONMENT_TYPE:-}/${ENVIRONMENT:-}" -f "${manifest}" > "${audit_file}" 2>&1; then
      passed=$((passed + 1))
    else
      failed=$((failed + 1))
      failed_files+=("${relative}")
    fi
  done
done

shopt -u globstar nullglob

if [[ ${scanned} -eq 0 ]]; then
  notify-error "No manifest files found to validate in ${manifests_dir}"
  exit 43
fi

if [[ ${failed} -eq 0 ]]; then
  notify-info "Validated ${scanned} files against the Kubernetes API - all passed"
else
  message="Validation failed: ${failed}/${scanned} files rejected"
  message+=$'\n'"Failed files:"
  for file in "${failed_files[@]}"; do
    message+=$'\n'"  - ${file}"
  done
  message+=$'\n'"To inspect validation output:"
  message+=$'\n'"  kubectl exec -it <pod> -- ls ${audit_dir}"
  message+=$'\n'"  kubectl exec -it <pod> -- cat ${audit_dir}/<filename>.txt"
  notify-error "${message}"
  exit 1
fi
